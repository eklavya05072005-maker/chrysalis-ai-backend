# ==============================================================================
# Chrysalis AI — Environment Configuration Template
# Copy this file to .env and supply your credentials. Never commit .env to Git!
# ==============================================================================

# Application
APP_NAME=Chrysalis AI Engine
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api

# Database Configuration
# Primary: PostgreSQL with Psycopg 3. If offline, Chrysalis automatically falls back to SQLite.
DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/chrysalis_db
# SQLite fallback example: DATABASE_URL=sqlite:///./data/chrysalis_dev.db

# Storage & Security
DATA_DIR=./data
MAX_UPLOAD_MB=10
FRONTEND_ORIGIN=http://localhost:3000

# LLM Configuration
# Provider choices: gemini | mock
LLM_PROVIDER=gemini

# Google AI Studio Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
