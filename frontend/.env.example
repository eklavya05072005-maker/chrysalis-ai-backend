# ==============================================================================
# URBEN.ENTT — Environment Variables Configuration Template
# ==============================================================================
# For local development:
# Backend reads from backend/.env or root .env
# Frontend reads from frontend/.env.local or root .env.local
# NEVER commit .env or .env.local to version control.
# ==============================================================================

# --- FRONTEND SERVICE CONFIGURATION ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# --- BACKEND SERVICE CONFIGURATION ---
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Admin Authentication Secret (Used for secure HMAC-SHA256 session token signing)
ADMIN_SESSION_SECRET=super-secret-random-32-character-key-here-12345

# --- SUPABASE PERSISTENCE CONFIGURATION ---
# (Optional: If left unconfigured, backend automatically operates with resilient local JSON store)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Initial Owner / Developer Seed Credentials
INITIAL_OWNER_EMAIL=owner@urben.entt
INITIAL_OWNER_PASSWORD=UrbenOwner2026!

# --- NOTIFICATION / ENQUIRY EMAIL SETTINGS (Optional) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_123456789
NOTIFICATION_RECEIVER_EMAIL=enquiries@urben.entt
